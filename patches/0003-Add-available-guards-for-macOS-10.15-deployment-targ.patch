From 8e50c92a25b0753d70a3506fb4e6bb44b5a2e433 Mon Sep 17 00:00:00 2001
From: Hiroshi Matoba <matobahiroshi@gmail.com>
Date: Tue, 10 Mar 2026 14:15:06 +0100
Subject: [PATCH] Add @available guards for macOS 10.15 deployment target

Add @available runtime guards for macOS 12+/11+ APIs:
- kIOMainPortDefault: @available fall back to kIOMasterPortDefault
- supportsPullModelInterpolation: guard with @available(macOS 11.0)
- supports32BitFloatFiltering: guard with @available(macOS 11.0)
- supportsBCTextureCompression: add macOS 11.0 to existing guard
- MTLLanguageVersion2_3/2_4: fall back to 2_2 on older macOS
- preserveInvariance: skip on <11.0
---
 src/common/apple_platform_utils.mm        | 11 +++++-
 src/gpu_info_util/SystemInfo_macos.mm     | 33 ++++++++++++++++--
 src/libANGLE/renderer/metal/DisplayMtl.mm | 41 +++++++++++++----------
 src/libANGLE/renderer/metal/mtl_utils.mm  | 17 ++++++++--
 4 files changed, 78 insertions(+), 24 deletions(-)

diff --git a/src/common/apple_platform_utils.mm b/src/common/apple_platform_utils.mm
index 09abd08..e8b81f7 100644
--- a/src/common/apple_platform_utils.mm
+++ b/src/common/apple_platform_utils.mm
@@ -125,8 +125,17 @@ bool IsMetalRendererAvailable()
 #if defined(ANGLE_PLATFORM_MACOS) || defined(ANGLE_PLATFORM_MACCATALYST)
 bool GetMacosMachineModel(std::string *outMachineModel)
 {
+    mach_port_t mainPort;
+    if (@available(macOS 12.0, *))
+    {
+        mainPort = kIOMainPortDefault;
+    }
+    else
+    {
+        mainPort = kIOMasterPortDefault;
+    }
     io_service_t platformExpert = IOServiceGetMatchingService(
-        kIOMainPortDefault, IOServiceMatching("IOPlatformExpertDevice"));
+        mainPort, IOServiceMatching("IOPlatformExpertDevice"));
 
     if (platformExpert == IO_OBJECT_NULL)
     {
diff --git a/src/gpu_info_util/SystemInfo_macos.mm b/src/gpu_info_util/SystemInfo_macos.mm
index 8da3839..285b0e7 100644
--- a/src/gpu_info_util/SystemInfo_macos.mm
+++ b/src/gpu_info_util/SystemInfo_macos.mm
@@ -67,7 +67,16 @@ void GetIORegistryDevices(std::vector<GPUDeviceInfo> *devices)
         CFMutableDictionaryRef matchDictionary = IOServiceMatching(kServiceNames[i]);
 
         io_iterator_t entryIterator;
-        if (IOServiceGetMatchingServices(kIOMainPortDefault, matchDictionary, &entryIterator) !=
+        mach_port_t mainPort;
+        if (@available(macOS 12.0, *))
+        {
+            mainPort = kIOMainPortDefault;
+        }
+        else
+        {
+            mainPort = kIOMasterPortDefault;
+        }
+        if (IOServiceGetMatchingServices(mainPort, matchDictionary, &entryIterator) !=
             kIOReturnSuccess)
         {
             continue;
@@ -162,7 +171,16 @@ void ForceGPUSwitchIndex(SystemInfo *info)
         return;
 
     CFMutableDictionaryRef matchDictionary = IORegistryEntryIDMatching(gpuID);
-    io_service_t gpuEntry = IOServiceGetMatchingService(kIOMainPortDefault, matchDictionary);
+    mach_port_t mainPort2;
+    if (@available(macOS 12.0, *))
+    {
+        mainPort2 = kIOMainPortDefault;
+    }
+    else
+    {
+        mainPort2 = kIOMasterPortDefault;
+    }
+    io_service_t gpuEntry = IOServiceGetMatchingService(mainPort2, matchDictionary);
 
     if (gpuEntry == IO_OBJECT_NULL)
     {
@@ -268,8 +286,17 @@ VendorID GetVendorIDFromMetalDeviceRegistryID(uint64_t registryID)
 
     // IOServiceGetMatchingService will consume the reference on the matching dictionary,
     // so we don't need to release the dictionary.
+    mach_port_t mainPort3;
+    if (@available(macOS 12.0, *))
+    {
+        mainPort3 = kIOMainPortDefault;
+    }
+    else
+    {
+        mainPort3 = kIOMasterPortDefault;
+    }
     io_registry_entry_t acceleratorEntry =
-        IOServiceGetMatchingService(kIOMainPortDefault, matchingDict);
+        IOServiceGetMatchingService(mainPort3, matchingDict);
     if (acceleratorEntry == IO_OBJECT_NULL)
     {
         return 0;
diff --git a/src/libANGLE/renderer/metal/DisplayMtl.mm b/src/libANGLE/renderer/metal/DisplayMtl.mm
index fe1f6d2..18e4b44 100644
--- a/src/libANGLE/renderer/metal/DisplayMtl.mm
+++ b/src/libANGLE/renderer/metal/DisplayMtl.mm
@@ -994,23 +994,26 @@ bool IsMetalDisplayAvailable()
 
     mNativeExtensions.sampleVariablesOES = true;
 
-    if ([mMetalDevice supportsPullModelInterpolation])
+    if (@available(macOS 11.0, iOS 14.0, *))
     {
-        mNativeExtensions.shaderMultisampleInterpolationOES = true;
-        mNativeCaps.subPixelInterpolationOffsetBits         = 4;
-        if (supportsAppleGPUFamily(1))
+        if ([mMetalDevice supportsPullModelInterpolation])
         {
-            mNativeCaps.minInterpolationOffset = -0.5f;
-            mNativeCaps.maxInterpolationOffset = +0.5f;
-        }
-        else
-        {
-            // On non-Apple GPUs, the actual range is usually
-            // [-0.5, +0.4375] but due to framebuffer Y-flip
-            // the effective range for the Y direction will be
-            // [-0.4375, +0.5] when the default FBO is bound.
-            mNativeCaps.minInterpolationOffset = -0.4375f;  // -0.5 + (2 ^ -4)
-            mNativeCaps.maxInterpolationOffset = +0.4375f;  // +0.5 - (2 ^ -4)
+            mNativeExtensions.shaderMultisampleInterpolationOES = true;
+            mNativeCaps.subPixelInterpolationOffsetBits         = 4;
+            if (supportsAppleGPUFamily(1))
+            {
+                mNativeCaps.minInterpolationOffset = -0.5f;
+                mNativeCaps.maxInterpolationOffset = +0.5f;
+            }
+            else
+            {
+                // On non-Apple GPUs, the actual range is usually
+                // [-0.5, +0.4375] but due to framebuffer Y-flip
+                // the effective range for the Y direction will be
+                // [-0.4375, +0.5] when the default FBO is bound.
+                mNativeCaps.minInterpolationOffset = -0.4375f;  // -0.5 + (2 ^ -4)
+                mNativeCaps.maxInterpolationOffset = +0.4375f;  // +0.5 - (2 ^ -4)
+            }
         }
     }
 
@@ -1362,7 +1365,11 @@ bool IsMetalDisplayAvailable()
 bool DisplayMtl::supports32BitFloatFiltering() const
 {
 #if !TARGET_OS_WATCH
-    return [mMetalDevice supports32BitFloatFiltering];
+    if (@available(macOS 11.0, iOS 14.0, *))
+    {
+        return [mMetalDevice supports32BitFloatFiltering];
+    }
+    return false;
 #else
     return false;
 #endif
@@ -1370,7 +1377,7 @@ bool IsMetalDisplayAvailable()
 
 bool DisplayMtl::supportsBCTextureCompression() const
 {
-    if (@available(macCatalyst 16.4, iOS 16.4, *))
+    if (@available(macOS 11.0, macCatalyst 16.4, iOS 16.4, *))
     {
         return [mMetalDevice supportsBCTextureCompression];
     }
diff --git a/src/libANGLE/renderer/metal/mtl_utils.mm b/src/libANGLE/renderer/metal/mtl_utils.mm
index 9c4ddf7..0f571ac 100644
--- a/src/libANGLE/renderer/metal/mtl_utils.mm
+++ b/src/libANGLE/renderer/metal/mtl_utils.mm
@@ -858,9 +858,17 @@ static MTLLanguageVersion GetUserSetOrHighestMSLVersion(const MTLLanguageVersion
                     case 2:
                         return MTLLanguageVersion2_2;
                     case 3:
-                        return MTLLanguageVersion2_3;
+                        if (@available(macOS 11.0, iOS 14.0, *))
+                        {
+                            return MTLLanguageVersion2_3;
+                        }
+                        return MTLLanguageVersion2_2;
                     case 4:
-                        return MTLLanguageVersion2_4;
+                        if (@available(macOS 12.0, iOS 15.0, *))
+                        {
+                            return MTLLanguageVersion2_4;
+                        }
+                        return MTLLanguageVersion2_2;
                     default:
                         assert(0 && "Unsupported MSL Minor Language Version.");
                 }
@@ -892,7 +900,10 @@ static MTLLanguageVersion GetUserSetOrHighestMSLVersion(const MTLLanguageVersion
         angle::ObjCPtr options  = angle::adoptObjCPtr([[MTLCompileOptions alloc] init]);
 
         // Mark all positions in VS with attribute invariant as non-optimizable
-        options.get().preserveInvariance = usesInvariance;
+        if (@available(macOS 11.0, iOS 14.0, *))
+        {
+            options.get().preserveInvariance = usesInvariance;
+        }
 
 // mathMode and mathFloatingPointFunctions are only available with macOS 15+ and iPhoneOS 18+
 #if __MAC_OS_X_VERSION_MAX_ALLOWED >= 150000 || __IPHONE_OS_VERSION_MAX_ALLOWED >= 180000 || \
-- 
2.50.1 (Apple Git-155)

